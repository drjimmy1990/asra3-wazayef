{
  "name": "Asra3.com — Automated 12h GCC Company Harvester",
  "nodes": [
    {
      "id": "1",
      "name": "Every 12 Hours Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 12
            }
          ]
        }
      }
    },
    {
      "id": "2",
      "name": "Trigger Harvester API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [520, 300],
      "parameters": {
        "method": "POST",
        "url": "https://asra3.com/api/admin/companies/seed-pack",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-admin-secret",
              "value": "YOUR_ADMIN_PASSCODE"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{ \"pagesPerChannel\": 8 }",
        "options": {}
      }
    }
  ],
  "connections": {
    "Every 12 Hours Schedule": {
      "main": [
        [
          {
            "node": "Trigger Harvester API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "saveManualExecutions": true,
    "saveExecutionProgress": true
  }
}
