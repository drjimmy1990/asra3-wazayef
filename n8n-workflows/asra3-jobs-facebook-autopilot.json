    {
      "id": "unpack-social-items",
      "name": "unpackQueueItems",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 300],
      "parameters": {
        "jsCode": "const cfg = $('configCredentials').first().json;\nconst payload = $input.first()?.json || {};\nconst items = Array.isArray(payload.items) ? payload.items : [];\n\nif (!items.length) {\n  return [];\n}\n\nif (!cfg.facebookPageId || cfg.facebookPageId === 'YOUR_FACEBOOK_PAGE_ID' || !cfg.facebookPageAccessToken || cfg.facebookPageAccessToken === 'YOUR_FACEBOOK_PAGE_ACCESS_TOKEN') {\n  throw new Error('Set facebookPageId and facebookPageAccessToken in configCredentials before activating Facebook publishing.');\n}\n\nreturn items.map((job) => ({\n  json: {\n    ...job,\n    instagram_budget: job.instagram_budget || payload.instagram_budget || null,\n    asra3BaseUrl: cfg.asra3BaseUrl,\n    webhookSecret: cfg.webhookSecret,\n    facebookPageId: cfg.facebookPageId,\n    facebookPageAccessToken: cfg.facebookPageAccessToken,\n    instagramAccountId: cfg.instagramAccountId || '',\n    instagramAccessToken: cfg.instagramAccessToken || '',\n    instagramEnabled: cfg.instagramEnabled ?? 'true',\n    instagramDailyCap: cfg.instagramDailyCap ?? '3',\n    telegramBotToken: cfg.telegramBotToken,\n    telegramChatId: cfg.telegramChatId,\n  },\n}));"
      }
    },
