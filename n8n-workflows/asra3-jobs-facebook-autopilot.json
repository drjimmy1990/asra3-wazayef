    {
      "id": "ig-check-status",
      "name": "igCheckContainerStatus",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [4560, 40],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true,
      "parameters": {
        "method": "GET",
        "url": "=https://graph.facebook.com/v21.0/{{ $('igPreparePoll').first().json.creation_id }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "status_code,status"
            },
            {
              "name": "access_token",
              "value": "={{ $('igPreparePoll').first().json.instagramAccessToken }}"
            }
          ]
        },
        "options": {
          "timeout": 20000
        }
      }
    },
    {
      "id": "ig-evaluate-poll",
      "name": "igEvaluatePoll",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [4820, 40],
      "parameters": {
        "jsCode": "const base = $('igPreparePoll').first().json;\nconst statusCode = String($json.status_code || '').toUpperCase();\nconst nodeData = $getWorkflowStaticData('node');\nif (!nodeData.pollAttempts || typeof nodeData.pollAttempts !== 'object') {\n  nodeData.pollAttempts = {};\n}\nconst keys = Object.keys(nodeData.pollAttempts);\nif (keys.length > 25) {\n  for (const k of keys.slice(0, keys.length - 15)) delete nodeData.pollAttempts[k];\n}\nconst attempt = Number(nodeData.pollAttempts[base.creation_id] || 0) + 1;\nnodeData.pollAttempts[base.creation_id] = attempt;\n\nlet action = 'retry';\nif (statusCode === 'FINISHED') {\n  action = 'publish';\n  delete nodeData.pollAttempts[base.creation_id];\n} else if (statusCode === 'ERROR' || statusCode === 'EXPIRED' || attempt >= 4) {\n  action = 'abort';\n  delete nodeData.pollAttempts[base.creation_id];\n}\n\nreturn [{\n  json: {\n    ...base,\n    ig_status_code: statusCode || 'UNKNOWN',\n    ig_poll_attempt: attempt,\n    ig_poll_action: action,\n  },\n}];"
      }
    },
    {
