# ==============================================================================
# ASRA3.COM (أسرع) — GCC AI CV Optimization & Direct HR Distribution Platform
# ==============================================================================

# Host Port Bound on Ubuntu VPS (127.0.0.1:3645 -> Container 3000 behind aaPanel Nginx)
APP_PORT=3645

# App Base URL (used for redirects & EasyKash callbacks)
NEXT_PUBLIC_APP_URL=https://asra3.com
NEXT_PUBLIC_SITE_URL=https://asra3.com

# Supabase Configuration (Optional in Local Demo Mode — falls back to persistent local store)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# EasyKash Payment Gateway (DirectPayV1 + HMAC-SHA512 Callback Verification)
# Obtain from EasyKash Merchant Dashboard -> Settings -> Integration Settings
EASYKASH_API_KEY=your-easykash-private-api-key
EASYKASH_HMAC_SECRET=your-easykash-hmac-sha512-secret
EASYKASH_API_URL=https://back.easykash.net/api/directpayv1/pay
EASYKASH_INQUIRE_URL=https://back.easykash.net/api/cash-api/inquire
# Expiration time in HOURS for cash channels (Fawry / Aman); default 24 hours
EASYKASH_CASH_EXPIRY_HOURS=24
# Leave empty to automatically show ALL payment methods enabled on your EasyKash account (Card, Apple Pay 31, Wallets 4, Fawry 5, Meeza 6, etc.)
EASYKASH_PAYMENT_OPTIONS=
# Leave empty to bill in local GCC currencies (AED/SAR/QAR/KWD), or set EGP / USD if your EasyKash account only settles in EGP/USD
EASYKASH_CURRENCY_OVERRIDE=

# n8n Automation Webhooks (Optional — built-in Multi-SMTP works natively inside Docker without n8n)
N8N_CV_ANALYZE_WEBHOOK=
N8N_CAMPAIGN_START_WEBHOOK=
N8N_SUPPORT_CHAT_WEBHOOK=https://n8n.pr-media.forum/webhook/asra3-support-chat
N8N_SUPPORT_LEAD_WEBHOOK=
N8N_WEBHOOK_SECRET=asra3-webhook-secret-2026

# Admin Access Passcode (Also derives cryptographic signature for HttpOnly Admin sessions & signed CV links)
ADMIN_PASSCODE=asra3@2026

# Built-In Direct SMTP Mailer (Optional default — you can also add/rotate multiple SMTPs inside /admin -> SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=dispatch@asra3.com
SMTP_FROM_NAME=Asra3 Executive Talent Desk
SMTP_DAILY_LIMIT=400
SMTP_DRIP_DELAY_MS=2500

# Analytics & Optional Instant Search Engine Indexing (Google Indexing API + IndexNow)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-M6784VRK96
INDEXNOW_KEY=
GOOGLE_INDEXING_ACCESS_TOKEN=

# Optional QA Safe Test Mode (LEAVE EMPTY IN NORMAL PRODUCTION)
# When BOTH are set, any campaign created by an email in QA_TEST_CANDIDATE_EMAILS
# will ONLY send to matching HR emails in QA_TEST_HR_EMAILS (never real companies).
QA_TEST_CANDIDATE_EMAILS=
QA_TEST_HR_EMAILS=
