{
  "name": "Asra3.com — Automated 2h GCC Jobs Harvester, Website & Facebook Autopilot",
  "nodes": [
    {
      "id": "schedule-3h",
      "name": "scheduleEvery3h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [180, 300],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 2
            }
          ]
        }
      }
    },
    {
      "id": "config-vars",
      "name": "configCredentials",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [420, 300],
      "notes": "Paste your ADMIN_PASSCODE / N8N_WEBHOOK_SECRET, Facebook Page ID, and Page Access Token here.",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-url",
              "name": "asra3BaseUrl",
              "type": "string",
              "value": "https://asra3.com"
            },
            {
              "id": "cfg-secret",
              "name": "webhookSecret",
              "type": "string",
              "value": "YOUR_N8N_WEBHOOK_SECRET_OR_ADMIN_PASSCODE"
            },
            {
              "id": "cfg-fb-page",
              "name": "facebookPageId",
              "type": "string",
              "value": "YOUR_FACEBOOK_PAGE_ID"
            },
            {
              "id": "cfg-fb-token",
              "name": "facebookPageAccessToken",
              "type": "string",
              "value": "YOUR_FACEBOOK_PAGE_ACCESS_TOKEN"
            },
            {
              "id": "cfg-tg-token",
              "name": "telegramBotToken",
              "type": "string",
              "value": ""
            },
            {
              "id": "cfg-tg-chat",
              "name": "telegramChatId",
              "type": "string",
              "value": ""
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "harvest-jobs-api",
      "name": "harvestJobsWebsite",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300],
      "retryOnFail": false,
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "={{ $json.asra3BaseUrl }}/api/webhooks/jobs-harvest",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-webhook-secret",
              "value": "={{ $json.webhookSecret }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"pagesPerChannel\": 2, \"maxJobsToInsert\": 15 }",
        "options": {
          "timeout": 180000
        }
      }
    },
    {
      "id": "fetch-social-queue",
      "name": "fetchSocialQueue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [940, 300],
      "parameters": {
        "method": "GET",
        "url": "={{ $('configCredentials').first().json.asra3BaseUrl }}/api/webhooks/jobs-social?limit=1",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-webhook-secret",
              "value": "={{ $('configCredentials').first().json.webhookSecret }}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      }
    },
    {
      "id": "unpack-social-items",
      "name": "unpackQueueItems",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 300],
      "parameters": {
        "jsCode": "const cfg = $('configCredentials').first().json;\nconst payload = $input.first()?.json || {};\nconst items = Array.isArray(payload.items) ? payload.items : [];\n\nif (!items.length) {\n  return [];\n}\n\nif (!cfg.facebookPageId || cfg.facebookPageId === 'YOUR_FACEBOOK_PAGE_ID' || !cfg.facebookPageAccessToken || cfg.facebookPageAccessToken === 'YOUR_FACEBOOK_PAGE_ACCESS_TOKEN') {\n  throw new Error('Set facebookPageId and facebookPageAccessToken in configCredentials before activating Facebook publishing.');\n}\n\nreturn items.map((job) => ({\n  json: {\n    ...job,\n    asra3BaseUrl: cfg.asra3BaseUrl,\n    webhookSecret: cfg.webhookSecret,\n    facebookPageId: cfg.facebookPageId,\n    facebookPageAccessToken: cfg.facebookPageAccessToken,\n    telegramBotToken: cfg.telegramBotToken,\n    telegramChatId: cfg.telegramChatId,\n  },\n}));"
      }
    },
    {
      "id": "prepare-job-reel",
      "name": "prepareJobReel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1460, 300],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "parameters": {
        "method": "GET",
        "url": "={{ $json.reel_prepare_url || ($json.asra3BaseUrl + '/api/reel/job/' + $json.slug + '?prepare=1') }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-webhook-secret",
              "value": "={{ $json.webhookSecret }}"
            }
          ]
        },
        "options": {
          "timeout": 115000
        }
      }
    },
    {
      "id": "fb-reel-start",
      "name": "fbReelStart",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1720, 300],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $('unpackQueueItems').item.json.facebookPageId }}/video_reels",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ upload_phase: 'start', access_token: $('unpackQueueItems').item.json.facebookPageAccessToken }) }}",
        "options": {
          "timeout": 25000
        }
      }
    },
    {
      "id": "fb-reel-upload",
      "name": "fbReelUpload",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1980, 300],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "parameters": {
        "method": "POST",
        "url": "={{ $json.upload_url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=OAuth {{ $('unpackQueueItems').item.json.facebookPageAccessToken }}"
            },
            {
              "name": "file_url",
              "value": "={{ $('prepareJobReel').item.json.reel_url }}"
            }
          ]
        },
        "sendBody": false,
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "fb-reel-finish",
      "name": "fbReelFinish",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2240, 300],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "alwaysOutputData": true,
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $('unpackQueueItems').item.json.facebookPageId }}/video_reels",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ upload_phase: 'finish', video_id: $('fbReelStart').item.json.video_id, video_state: 'PUBLISHED', description: $('unpackQueueItems').item.json.facebook_reel_caption || $('unpackQueueItems').item.json.facebook_photo_caption, access_token: $('unpackQueueItems').item.json.facebookPageAccessToken }) }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "wait-reel-processing",
      "name": "waitReelProcessing",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [2500, 300],
      "parameters": {
        "resume": "timeInterval",
        "amount": 15,
        "unit": "seconds"
      }
    },
    {
      "id": "fb-publish-photo",
      "name": "publishFacebookPhoto",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1460, 560],
      "disabled": true,
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "alwaysOutputData": true,
      "notes": "Deactivated — replaced by 3-phase Motion-Graphics Reels publishing.",
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $json.facebookPageId }}/photos",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ url: $json.og_image_url, caption: $json.facebook_photo_caption, access_token: $json.facebookPageAccessToken }) }}",
        "options": {
          "timeout": 25000
        }
      }
    },
    {
      "id": "fb-first-comment",
      "name": "postFirstCommentLink",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2760, 300],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $('fbReelFinish').item.json.post_id ? (String($('fbReelFinish').item.json.post_id).includes('_') ? $('fbReelFinish').item.json.post_id : $('unpackQueueItems').item.json.facebookPageId + '_' + $('fbReelFinish').item.json.post_id) : $('fbReelStart').item.json.video_id }}/comments",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message: $('unpackQueueItems').item.json.facebook_first_comment, access_token: $('unpackQueueItems').item.json.facebookPageAccessToken }) }}",
        "options": {
          "timeout": 15000
        }
      }
    },
    {
      "id": "tg-optional-broadcast",
      "name": "optionalTelegramChannel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2760, 520],
      "disabled": true,
      "onError": "continueRegularOutput",
      "notes": "Enable this node once telegramBotToken and telegramChatId are filled in configCredentials.",
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $('unpackQueueItems').item.json.telegramBotToken }}/sendPhoto",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $('unpackQueueItems').item.json.telegramChatId, photo: $('unpackQueueItems').item.json.og_image_url, caption: $('unpackQueueItems').item.json.telegram_html, parse_mode: 'HTML' }) }}",
        "options": {}
      }
    },
    {
      "id": "mark-posted-callback",
      "name": "markJobPosted",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3040, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $('unpackQueueItems').item.json.asra3BaseUrl }}/api/webhooks/jobs-social",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-webhook-secret",
              "value": "={{ $('unpackQueueItems').item.json.webhookSecret }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ id: $('unpackQueueItems').item.json.id, fb_post_id: $('fbReelFinish').item.json.post_id ? (String($('fbReelFinish').item.json.post_id).includes('_') ? $('fbReelFinish').item.json.post_id : $('unpackQueueItems').item.json.facebookPageId + '_' + $('fbReelFinish').item.json.post_id) : ($('fbReelStart').item.json.video_id || 'reel_posted') }) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "scheduleEvery3h": {
      "main": [
        [
          {
            "node": "configCredentials",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "configCredentials": {
      "main": [
        [
          {
            "node": "harvestJobsWebsite",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "harvestJobsWebsite": {
      "main": [
        [
          {
            "node": "fetchSocialQueue",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "fetchSocialQueue": {
      "main": [
        [
          {
            "node": "unpackQueueItems",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "unpackQueueItems": {
      "main": [
        [
          {
            "node": "prepareJobReel",
            "type": "main",
            "index": 0
          },
          {
            "node": "publishFacebookPhoto",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "prepareJobReel": {
      "main": [
        [
          {
            "node": "fbReelStart",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "fbReelStart": {
      "main": [
        [
          {
            "node": "fbReelUpload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "fbReelUpload": {
      "main": [
        [
          {
            "node": "fbReelFinish",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "fbReelFinish": {
      "main": [
        [
          {
            "node": "waitReelProcessing",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "waitReelProcessing": {
      "main": [
        [
          {
            "node": "postFirstCommentLink",
            "type": "main",
            "index": 0
          },
          {
            "node": "optionalTelegramChannel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "postFirstCommentLink": {
      "main": [
        [
          {
            "node": "markJobPosted",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
