    {
      "id": "ig-evaluate-gate",
      "name": "evaluateInstagramGate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3040, 300],
      "notes": "Enforces Instagram warmup cap (2–3 Reels/day) during Gulf peak hours (07–10, 11–15, 19–22 GST) with 3.5h minimum spacing.",
      "parameters": {
        "jsCode": "const job = $('unpackQueueItems').first().json;\nconst reel = $('prepareJobReel').first().json || {};\nconst fbFinish = $('fbReelFinish').first().json || {};\nconst fbStart = $('fbReelStart').first().json || {};\n\nconst fbPostId = fbFinish.post_id\n  ? (String(fbFinish.post_id).includes('_') ? String(fbFinish.post_id) : `${job.facebookPageId}_${fbFinish.post_id}`)\n  : (fbStart.video_id ? String(fbStart.video_id) : 'reel_posted');\n\nconst reelUrl = reel.reel_url || job.reel_video_url || '';\nconst igEnabled = String(job.instagramEnabled ?? 'true').trim().toLowerCase() === 'true';\nconst hasCreds =\n  Boolean(job.instagramAccountId) &&\n  job.instagramAccountId !== 'YOUR_INSTAGRAM_BUSINESS_ACCOUNT_ID' &&\n  Boolean(job.instagramAccessToken) &&\n  job.instagramAccessToken !== 'YOUR_INSTAGRAM_ACCESS_TOKEN';\n\nconst rawCap = String(job.instagramDailyCap ?? '3').trim();\nconst parsedCap = rawCap === '' ? 3 : Number(rawCap);\nconst dailyCap = Number.isFinite(parsedCap) ? Math.max(0, Math.min(6, Math.floor(parsedCap))) : 3;\n\nconst nowMs = Date.now();\nconst gstDateObj = new Date(nowMs + 4 * 60 * 60 * 1000);\nconst gstDate = `${gstDateObj.getUTCFullYear()}-${String(gstDateObj.getUTCMonth() + 1).padStart(2, '0')}-${String(gstDateObj.getUTCDate()).padStart(2, '0')}`;\nconst gstHour = gstDateObj.getUTCHours();\nconst peakSlot = (gstHour >= 7 && gstHour <= 10) ? 'morning' : (gstHour >= 11 && gstHour <= 15) ? 'midday' : (gstHour >= 19 && gstHour <= 22) ? 'evening' : null;\n\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.igDailyTracker || staticData.igDailyTracker.gstDate !== gstDate) {\n  staticData.igDailyTracker = { gstDate, count: 0, slotsUsed: [], lastPostedAt: staticData.igDailyTracker?.lastPostedAt || null };\n}\nconst tracker = staticData.igDailyTracker;\nconst serverBudget = job.instagram_budget || {};\n\nconst serverCount = serverBudget.gst_date === gstDate ? Number(serverBudget.published_today_gst || 0) : 0;\nconst effectiveCount = Math.max(Number(tracker.count || 0), serverCount);\nconst effectiveSlots = Array.from(new Set([\n  ...(Array.isArray(tracker.slotsUsed) ? tracker.slotsUsed : []),\n  ...(serverBudget.gst_date === gstDate && Array.isArray(serverBudget.slots_used_today) ? serverBudget.slots_used_today : []),\n]));\n\nconst lastCandidates = [tracker.lastPostedAt, serverBudget.last_ig_posted_at]\n  .map((iso) => (iso ? Date.parse(iso) : NaN))\n  .filter((ms) => Number.isFinite(ms));\nconst lastPostedMs = lastCandidates.length ? Math.max(...lastCandidates) : 0;\nconst minSpacingOk = !lastPostedMs || (nowMs - lastPostedMs) >= 3.5 * 60 * 60 * 1000;\n\nlet skipReason = null;\nif (!igEnabled) skipReason = 'instagram_disabled';\nelse if (!hasCreds) skipReason = 'missing_instagram_credentials';\nelse if (!reelUrl) skipReason = 'missing_reel_url';\nelse if (dailyCap <= 0) skipReason = 'daily_cap_zero';\nelse if (effectiveCount >= dailyCap) skipReason = 'daily_cap_reached';\nelse if (!peakSlot) skipReason = 'outside_gulf_peak_hours';\nelse if (effectiveSlots.includes(peakSlot)) skipReason = `peak_slot_${peakSlot}_already_used`;\nelse if (!minSpacingOk) skipReason = 'min_spacing_guard';\n\nconst igCaption = job.instagram_reel_caption || job.facebook_reel_caption || '';\n\nreturn [{\n  json: {\n    job_id: job.id,\n    slug: job.slug,\n    asra3BaseUrl: job.asra3BaseUrl,\n    webhookSecret: job.webhookSecret,\n    fb_post_id: fbPostId,\n    ig_post_id: null,\n    reel_url: reelUrl,\n    instagramAccountId: job.instagramAccountId,\n    instagramAccessToken: job.instagramAccessToken,\n    instagram_reel_caption: igCaption,\n    should_publish_ig: skipReason === null,\n    ig_skip_reason: skipReason,\n    gst_date: gstDate,\n    gst_hour: gstHour,\n    gst_slot: peakSlot,\n    ig_count_today: effectiveCount,\n    ig_daily_cap: dailyCap,\n  },\n}];"
      }
    },
