        "jsCode": "const base = $('evaluateInstagramGate').first().json;\nconst creationId = $json.id ? String($json.id) : '';\nreturn [{\n  json: {\n    ...base,\n    creation_id: creationId,\n    has_creation_id: Boolean(creationId),\n    ig_create_error: creationId ? null : ($json.error?.message || 'no_creation_id'),\n  },\n}];"
