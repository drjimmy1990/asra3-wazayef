# ==============================================================================
# ASRA3.COM (أسرع) — GCC AI CV Optimization & Direct HR Distribution Platform
# ==============================================================================

# Host Port Bound on Ubuntu VPS (127.0.0.1:3645 -> Container 3000 behind aaPanel Nginx)
APP_PORT=3645

# App Base URL (used for redirects & EasyKash callbacks)
NEXT_PUBLIC_APP_URL=https://asra3.com
NEXT_PUBLIC_SITE_URL=https://asra3.com

# Supabase Configuration (Optional in Local Demo Mode — falls back to persistent local store)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# EasyKash Payment Gateway (DirectPayV1 + HMAC-SHA512 Callback Verification)
# Obtain from EasyKash Merchant Dashboard -> Settings -> Integration Settings
EASYKASH_API_KEY=your-easykash-private-api-key
EASYKASH_HMAC_SECRET=your-easykash-hmac-sha512-secret
EASYKASH_API_URL=https://back.easykash.net/api/directpayv1/pay
EASYKASH_CASH_EXPIRY_DAYS=3

# n8n Automation Webhooks
N8N_CV_ANALYZE_WEBHOOK=https://n8n.pr-media.forum/webhook/asra3-cv-analyze
N8N_CAMPAIGN_START_WEBHOOK=https://n8n.pr-media.forum/webhook/asra3-campaign-start
N8N_WEBHOOK_SECRET=asra3-webhook-secret-2026

# Admin Access Passcode & Session Secret (for HttpOnly Admin Session Cookie & CV Signed URLs)
ADMIN_PASSCODE=asra3@2026
ADMIN_SESSION_SECRET=replace-with-random-64-char-hex-in-production

# Built-In Direct SMTP Mailer (Optional default — you can also add/rotate multiple SMTPs inside /admin -> SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=dispatch@asra3.com
SMTP_FROM_NAME=Asra3 Executive Talent Desk
SMTP_DAILY_LIMIT=400
SMTP_DRIP_DELAY_MS=2500
